{
  "name": "codefactory",
  "version": "1.73.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "cargo:shared": "node scripts/cargo-shared.mjs",
    "test:worktree-lifecycle": "node --test scripts/worktree-cargo-target.test.mjs",
    "worktrees": "node scripts/worktree-janitor.mjs",
    "worktrees:clean": "node scripts/worktree-janitor.mjs --apply --stale-days 7",
    "worktrees:closeout": "node scripts/worktree-closeout.mjs",
    "test": "vitest run",
    "test:rust:fast": "node scripts/cargo-shared.mjs test --manifest-path src-tauri/Cargo.toml",
    "test:evolution:headless": "node scripts/verify-evolution-workbench-headless.mjs",
    "test:repository-intent:headless": "node scripts/verify-repository-intent-headless.mjs",
    "test:resume:headless": "node scripts/verify-resume-journal-headless.mjs",
    "test:usage:headless": "node scripts/verify-token-usage-headless.mjs",
    "test:attachments:asset-scope": "node scripts/verify-attachment-asset-scope.mjs",
    "test:reconnect-banner:headless": "node scripts/verify-reconnect-banner-headless.mjs",
    "test:streaming-markdown:headless": "node scripts/verify-streaming-markdown-headless.mjs",
    "test:permission-mode:headless": "node scripts/verify-permission-mode-headless.mjs",
    "test:startup-session:headless": "node scripts/verify-startup-session-headless.mjs",
    "test:sidebar-expansion:headless": "node scripts/verify-sidebar-expansion-headless.mjs",
    "test:image-preview:headless": "node scripts/verify-image-preview-headless.mjs",
    "test:watch": "vitest",
    "test:scrollbar:headless": "node scripts/verify-scrollbar-auto-hide-headless.mjs",
    "ext:build": "node scripts/build-extension.mjs",
    "verify:extension": "node scripts/verify-extension-bridge.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cmdk": "^1.0.0",
    "diff": "^7.0.0",
    "diff2html": "^3.4.48",
    "lucide-react": "^0.447.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.22.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "^10.4.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
