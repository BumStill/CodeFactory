{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeFactory",
  "version": "1.81.20",
  "identifier": "com.codefactory.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeFactory",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/.codefactory/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/skills/react-expert/manifest.json",
      "resources/skills/react-expert/system_prompt.md",
      "resources/skills/react-expert/slash_commands.json",
      "resources/skills/code-reviewer/manifest.json",
      "resources/skills/code-reviewer/system_prompt.md",
      "resources/skills/code-reviewer/slash_commands.json",
      "resources/skills/code-reviewer/tool_policy.json",
      "resources/skills/git-workflow/manifest.json",
      "resources/skills/git-workflow/system_prompt.md",
      "resources/skills/git-workflow/slash_commands.json"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/BumStill/CodeFactory/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFRTMxMUJEOTc5NjNCOTkKUldTWk81YVh2UkhqUHJDZmczY040cUc0eFNvaG1SL3BHT2F0aWk1UWhEcjBFUk0zM1NteFVLeU4K"
    }
  }
}
