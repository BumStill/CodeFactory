{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default CodeFactory capabilities",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:app:allow-set-app-theme",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
