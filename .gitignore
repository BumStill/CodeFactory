# Rust / Cargo build artifacts
target/
# The post-checkout hook links src-tauri/target at the shared cache, and a
# symlink is not a directory — `target/` does not match it, so every worktree
# offers it to `git add -A`. Match it as a plain path too.
src-tauri/target
.codefactory-cache/
**/*.rs.bk

# Node / pnpm
node_modules/
dist/

# Python
__pycache__/
*.pyc

# Tauri dev
src-tauri/WixTools/
.codex/run-logs/
.codefactory/benchmark-jobs/
.codefactory/product-acceptance/

# SQLite databases and secrets (never commit)
*.db
*.db-shm
*.db-wal
keys.json

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build outputs
*.msi
icon-source.png
