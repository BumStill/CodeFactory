#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
  exec python3 tools/git/ensure_branch_current.py
fi

if command -v python >/dev/null 2>&1; then
  exec python tools/git/ensure_branch_current.py
fi

if command -v py >/dev/null 2>&1; then
  exec py -3 tools/git/ensure_branch_current.py
fi

echo "sync-gate: Python 3 is required to run tools/git/ensure_branch_current.py" >&2
exit 1
