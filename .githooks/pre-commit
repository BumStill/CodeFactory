#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_python() {
  if command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v python >/dev/null 2>&1; then
    python "$@"
  elif command -v py >/dev/null 2>&1; then
    py -3 "$@"
  else
    echo "governance-gate: Python 3 is required" >&2
    exit 1
  fi
}

run_python tools/git/ensure_branch_current.py
run_python tools/governance/run_scenario_harness_gate.py \
  --stage local --repo . --policy-repo .
