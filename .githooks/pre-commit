#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_python() {
  # The governance gate imports tomllib, so pick the first interpreter that
  # actually has it instead of the first one on PATH (macOS still ships 3.9).
  for candidate in python3 python python3.13 python3.12 python3.11 py; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
      "$candidate" "$@"
      return
    fi
  done
  if command -v py >/dev/null 2>&1; then
    py -3 "$@"
  elif command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v python >/dev/null 2>&1; then
    python "$@"
  else
    echo "governance-gate: Python 3.11+ is required (tomllib)" >&2
    exit 1
  fi
}

run_python tools/git/ensure_branch_current.py
run_python tools/governance/run_scenario_harness_gate.py \
  --stage local --repo . --policy-repo .
