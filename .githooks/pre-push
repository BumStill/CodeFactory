#!/usr/bin/env sh
set -eu

# Git supplies one line per ref on stdin. A deletion has an all-zero local
# object ID; it cannot introduce code and therefore has no candidate tree for
# the product scenario gate to judge. Mixed delete/update pushes still gate.
zero_oid="0000000000000000000000000000000000000000"
saw_ref=0
has_update=0
while IFS=' ' read -r _local_ref local_oid _remote_ref _remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  saw_ref=1
  if [ "$local_oid" != "$zero_oid" ]; then
    has_update=1
  fi
done
if [ "$saw_ref" -eq 1 ] && [ "$has_update" -eq 0 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_gate() {
  # The gate imports tomllib, so pick the first interpreter that actually has
  # it instead of the first one on PATH (macOS still ships 3.9). The gate is
  # still mandatory: this only chooses which interpreter runs it.
  for candidate in python3 python python3.13 python3.12 python3.11 py; do
    if command -v "$candidate" >/dev/null 2>&1 \
      && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
      exec "$candidate" tools/governance/run_scenario_harness_gate.py \
        --stage local --repo . --policy-repo .
    fi
  done
  if command -v py >/dev/null 2>&1; then
    exec py -3 tools/governance/run_scenario_harness_gate.py \
      --stage local --repo . --policy-repo .
  fi
  echo "scenario-gate: Python 3.11+ is required (tomllib)" >&2
  exit 1
}

run_gate
